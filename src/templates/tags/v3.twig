{{ hiddenInput|raw }}
<script src="https://www.google.com/recaptcha/api.js?render={{ siteKey }}" {{- scriptAttributes|raw }}></script>
{%~ if formId %}
    <script {{- scriptAttributes|raw }}>
        (function() {
            var formId = {{ formId|json_encode|raw }};
            var fieldId = {{ id|json_encode|raw }};

            // v3 tokens expire two minutes after they are minted, so we mint one
            // when the form is submitted rather than when the page loads. Without
            // this, anyone who takes longer than two minutes to fill the form in
            // is rejected with "timeout-or-duplicate".
            var pending = false;

            // Every node is looked up when it is needed rather than held onto,
            // and the listener is delegated from the document. Anything that
            // re-renders the page — Vue's runtime compiler, htmx, Turbo — replaces
            // the form node, which silently discards a listener bound directly to
            // it and leaves the token field empty.
            var submitAnyway = function() {
                pending = false;

                var form = document.getElementById(formId);

                if (form) {
                    // form.submit() does not fire this event, so it cannot recurse.
                    form.submit();
                }
            };

            document.addEventListener('submit', function(event) {
                if (!event.target || event.target.id !== formId) {
                    return;
                }

                // Native constraint validation has already passed by this point,
                // so required fields still behave as they would without us.
                event.preventDefault();

                // Swallow extra clicks while a token is in flight.
                if (pending) {
                    return;
                }

                // Only reachable if api.js was blocked or failed to load. Submit
                // regardless: the server still rejects the submission, which is a
                // far better outcome than a Send button that silently does
                // nothing. Verification stays server-side either way.
                if (typeof grecaptcha === 'undefined' || !grecaptcha.ready) {
                    submitAnyway();
                    return;
                }

                pending = true;

                // ready() queues the callback until the API has initialised, so a
                // click made before then still gets a token.
                grecaptcha.ready(function() {
                    var token = grecaptcha.execute({{ siteKey|json_encode|raw }}, {
                        action: {{ action|json_encode|raw }}
                    }).then(function(value) {
                        var field = document.getElementById(fieldId);

                        if (field) {
                            field.value = value;
                        }
                    });

                    // Don't strand the user if reCAPTCHA hangs or rejects.
                    var timeout = new Promise(function(resolve) {
                        window.setTimeout(resolve, 10000);
                    });

                    Promise.race([token, timeout]).catch(function() {}).then(submitAnyway);
                });
            }, true);
        })();
    </script>
{% else %}
    <script {{- scriptAttributes|raw }}>
        grecaptcha.ready(function() {
            grecaptcha.execute("{{ siteKey }}", {
                action: "{{ action }}"
            }).then(function(token) {
                document.getElementById("{{ id }}").value = token;
            });
        });
    </script>
{% endif ~%}
